+void WindowMain::scanOnlyToggled(bool clicked)
+{
+    t1.scanOnly.store(clicked);
+    t2.scanOnly.store(clicked);
+    userinfo["scan_only"] = clicked;
+    m_config->updateConfig(userinfo.dump());
+    if (!clicked)
+    {
+        scanCount = 0;
+        ui.labelScanStatus->setText("未开始扫码");
+    }
+    else
+    {
+        ui.labelScanStatus->setText("只扫码不确认模式已开启，扫完自动监视下一个…");
+    }
+}
+
+void WindowMain::scanOnlyScanned(const QString& ticket)
+{
+    if (ticket.isEmpty())
+    {
+        ui.labelScanStatus->setText("当前二维码扫码失败，继续监视…");
+        return;
+    }
+    ++scanCount;
+    QString shortTicket = ticket;
+    if (shortTicket.size() > 12)
+    {
+        shortTicket = shortTicket.left(6) + "…" + shortTicket.right(6);
+    }
+    ui.labelScanStatus->setText(QString("已扫 %1 个，最新: %2").arg(scanCount).arg(shortTicket));
+}
